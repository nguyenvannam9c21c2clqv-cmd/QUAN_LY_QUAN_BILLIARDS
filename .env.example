
# ==========================================
# BILLIARDS MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION
# ==========================================

# Thông tin ứng dụng
APP_NAME=Billiards Management
APP_ENV=development
APP_DEBUG=True
APP_PORT=5000

# Bảo mật
SECRET_KEY=change-this-to-a-random-secret-key
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# Cấu hình ứng dụng Node.js
PORT=3000
ACCOUNT_DATABASE_PATH=data/accounts.sqlite

# Chỉ dùng để tạo quản trị viên đầu tiên bằng npm run create-admin.
# Xóa INITIAL_ADMIN_PASSWORD khỏi .env sau khi tạo xong.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FULL_NAME=Quản trị viên
INITIAL_ADMIN_PASSWORD=

# Cấu hình nhánh Python riêng (nếu sử dụng)
DATABASE_TYPE=sqlite
DATABASE_PATH=database/billiards.db

# Quản lý thời gian
TIMEZONE=Asia/Ho_Chi_Minh
LANGUAGE=vi

# Cấu hình đăng nhập
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/system.log

# Cấu hình cửa hàng
STORE_NAME=Quan Bida
STORE_ADDRESS=
STORE_PHONE=

# Cấu hình thanh toán
DEFAULT_CURRENCY=VND
DEFAULT_PAYMENT_METHOD=cash

# Cấu hình máy chủ
HOST=127.0.0.1
